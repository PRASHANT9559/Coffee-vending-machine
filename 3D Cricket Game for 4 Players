@supports (background: color-mix(in srgb,red 30%,transparent)) {
  .md-text-select__highlight-block { opacity: 1; background-color: color-mix(in srgb,var(--container-brandprimary-fill) 30%,transparent); }
}

.md-text-select__handle-layer { position: absolute; inset: 0px; z-index: 4; pointer-events: none; overflow: visible; }

.md-text-select__handle { position: absolute; z-index: 1; display: flex; flex-direction: column; align-items: center; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: none; cursor: grab; touch-action: none; pointer-events: auto; transform: translateZ(0px); --md-handle-color: var(--container-brandprimary-fill); }

.md-text-select__handle:active { cursor: grabbing; }

.md-text-select__handle:active .md-text-select__handle-knob { transform: scale(1.12); }

.md-text-select__handle-knob { width: var(--md-handle-knob, 12px); height: var(--md-handle-knob, 12px); border-radius: 50%; background: var(--md-handle-color, var(--container-brandprimary-fill)); flex-shrink: 0; transition: transform 0.1s; }

.md-text-select__handle-stem { width: 2px; height: var(--md-handle-stem, 18px); background: var(--md-handle-color, var(--container-brandprimary-fill)); flex-shrink: 0; }

@media (pointer: coarse) {
  .md-text-select--active .md-text-select__handle { --md-handle-knob: 14px; }
  .md-text-select--active .md-text-select__handle::before { inset: -12px; }
}

.md-text-select__menu { position: fixed; z-index: 1001; }

.language-menu-popover, .language-dropdown, .select-language-container { touch-action: auto !important; }
