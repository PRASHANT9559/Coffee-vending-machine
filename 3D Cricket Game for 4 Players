.md-text-select { position: relative; overflow: visible; user-select: none; touch-action: pan-y; }

.md-text-select::selection, .md-text-select ::selection { color: inherit; background: transparent !important; }

.md-text-select__content { position: relative; z-index: 1; user-select: none; }

.md-text-select__content * { user-select: none; }

.md-text-select__plain-text { white-space: pre-wrap; overflow-wrap: break-word; font-size: 0.875rem; line-height: 1.625; }

.md-text-select--active { user-select: none; }

.md-text-select--active .md-text-select__content, .md-text-select--active .md-text-select__content * { user-select: none !important; }

.md-text-select__highlight-layer { position: absolute; inset: 0px; z-index: 2; pointer-events: none; overflow: hidden; }

